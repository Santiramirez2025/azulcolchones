# ============================================================================
# AZUL COLCHONES — env vars
# Copiar a .env.local y completar. NO commitear .env ni .env.local.
# ============================================================================

# ─── Database (Prisma + Postgres en Supabase / Neon) ────────────────────────
# Pooled URL para queries (usar pgbouncer=true en Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true
# URL directa para migraciones (sin pooler)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ─── Emails (Resend) ────────────────────────────────────────────────────────
# Crear API key en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Email "from" (debe estar verificado en Resend) — default: onboarding@resend.dev
FROM_EMAIL=info@azulcolchones.com
# Email a donde llegan las nuevas reservas — default: info@azulcolchones.com
NOTIFICATION_EMAIL=info@azulcolchones.com

# ─── Site URLs ──────────────────────────────────────────────────────────────
# URL pública del sitio para sitemap, OG tags y redirects
NEXT_PUBLIC_SITE_URL=https://azulcolchones.com.ar

# Token de verificación de Google Search Console (opcional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Mercado Pago (Checkout Pro) ────────────────────────────────────────────
# Credenciales en https://www.mercadopago.com.ar/developers/panel/app
# TEST-... para sandbox, APP_USR-... para producción.
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Secret del webhook (opcional, recomendado) → valida la firma x-signature.
MP_WEBHOOK_SECRET=
# Base URL pública para back_urls y notification_url (en local: http://localhost:3000).
# En prod usa NEXT_PUBLIC_SITE_URL si no se setea.
MP_BASE_URL=

# ─── Cron jobs (Vercel) ─────────────────────────────────────────────────────
# Vercel auto-genera este secret cuando habilitás Cron en el dashboard.
# El endpoint /api/cron/expire-reservas valida Authorization: Bearer ${CRON_SECRET}.
CRON_SECRET=
